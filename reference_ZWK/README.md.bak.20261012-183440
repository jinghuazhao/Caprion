python - <<'PY'
from pathlib import Path

source_dir = Path.home() / "Caprion/analysis/ZWK/mzML"
output = Path.home() / "Caprion/analysis/ZWK/reference_ZWK/config/ZWK-reference-panel.fp-manifest"

files = sorted(source_dir.glob("*.mzML"))

if len(files) != 98:
    raise SystemExit(f"Expected 98 mzML files; found {len(files)}")

if output.exists():
    raise SystemExit(f"Manifest already exists; refusing to overwrite: {output}")

rows = []
for f in files:
    name = f.stem
    # Use the leading acquisition prefix as a neutral, reproducible label.
    # This does not claim to identify the biological sample group.
    group = name.split("xms", 1)[0]
    rows.append(f"{f.resolve()}\t{group}\tDDA")

if len({row.split("\t")[0] for row in rows}) != 98:
    raise SystemExit("Duplicate source paths detected")

output.parent.mkdir(parents=True, exist_ok=True)
output.write_text("\n".join(rows) + "\n")

print(f"Created: {output}")
print(f"Entries: {len(rows)}")
print("\nFirst 5 entries:")
print("\n".join(rows[:5]))
PY

